# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Alternative name also accepted by Growing Math backend.
GOOGLE_API_KEY="MY_GEMINI_API_KEY"

# AI provider selection for desktop backend: auto, gemini, or ollama.
AI_PROVIDER="auto"

# Ollama local endpoint and model name (used when AI_PROVIDER=ollama,
# or automatically when AI_PROVIDER=auto and Gemini key is absent).
# No Windows, o instalador grava estes valores automaticamente em um .env
# ao lado do executavel, conforme o modelo escolhido na instalacao.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"

# Tempo maximo de geracao do modelo local, em ms (padrao 120000; min 5000, max 600000).
# Modelos maiores rodando em CPU passam facilmente de 60s; valores baixos abortam
# a geracao e forcam o exercicio estatico de fallback.
OLLAMA_TIMEOUT_MS="120000"

# Proxy corporativo: o Ollama e escrito em Go e NAO le o proxy do Windows.
# O instalador propaga o proxy do sistema para estas variaveis automaticamente.
# HTTPS_PROXY="http://proxy.empresa:80"
# NO_PROXY="127.0.0.1,localhost"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security: mandatory secrets for auth hardening.
# Use long random values (at least 32 chars).
# Obrigatorios quando HOST estiver fora do loopback (o servidor recusa iniciar sem eles).
# Em modo desktop local, se ausentes, o servidor gera e persiste valores aleatorios.
AUTH_JWT_SECRET="CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_32_PLUS"

# Optional extra secret mixed into password hashing.
AUTH_PASSWORD_PEPPER="CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET"

# Set to "true" to reject legacy password hashes created before the pepper rollout.
# Hashes validos sao migrados automaticamente no proximo login.
AUTH_DISABLE_LEGACY_PASSWORD_FALLBACK="false"

# Optional token expiration (in seconds).
AUTH_TOKEN_TTL_SECONDS="28800"
AUTH_TEACHER_TOKEN_TTL_SECONDS="28800"

# Required teacher access code for teacher account creation.
# Se ausente em modo local, um codigo aleatorio e gerado e salvo em
# teacher-access-code.txt, ao lado do banco de dados.
TEACHER_ACCESS_CODE="CHANGE_ME_TEACHER_ACCESS_CODE"

# Host/porta do backend. Padrao 127.0.0.1 (apenas local).
# Alterar para 0.0.0.0 exige AUTH_JWT_SECRET e TEACHER_ACCESS_CODE configurados.
HOST="127.0.0.1"
PORT="3000"

# ---------------------------------------------------------------------------
# Servidor hospedado (AWS) - opcional. Vazio = modo local de hoje.
# ---------------------------------------------------------------------------

# NA MAQUINA DO ALUNO/PROFESSOR: URL da API hospedada.
# Vazio (padrao) mantem tudo local: o app usa o proprio servidor embutido.
# Preenchido, o app continua rodando localmente mas os dados passam a vir da
# nuvem. O valor e lido em runtime - trocar de servidor NAO exige reinstalar.
# API_BASE_URL="https://api.growingmath.suaempresa.com"

# NO SERVIDOR (AWS): caminho do banco. Use um volume persistente (EBS), nunca
# um diretorio efemero, ou os dados somem a cada deploy.
# GROWING_MATH_DB_PATH="/var/lib/growing-math/growing_math.db"

# NO SERVIDOR (AWS): fuso horario usado para definir o "dia civil" do desafio
# diario (chave do desafio, janela do historico e streak). Padrao America/Sao_Paulo.
# IMPORTANTE: instancias EC2/ECS rodam em UTC. Sem esta variavel o dia viraria as
# 21h no horario de Brasilia, fazendo o desafio concluido sumir do historico,
# quebrar a streak e permitir resgatar a recompensa duas vezes na mesma noite.
# APP_TIMEZONE="America/Sao_Paulo"

# NO SERVIDOR (AWS): origens autorizadas a chamar a API, separadas por virgula.
# Vazio + CORS_ALLOW_LOOPBACK=true (padrao) aceita qualquer origem loopback,
# que e o caso do app desktop (a porta local muda a cada inicializacao).
# CORS_ALLOWED_ORIGINS="https://app.growingmath.suaempresa.com"
# CORS_ALLOW_LOOPBACK="true"
